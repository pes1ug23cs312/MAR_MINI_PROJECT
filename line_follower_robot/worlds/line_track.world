<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="line_track_world">

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
      </ode>
    </physics>

    <light name="sun" type="directional">
      <cast_shadows>1</cast_shadows>
      <direction>0.5 0.5 -1</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>14 14</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>14 14</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Complex line network: nodes S(3.2,2.2), A(0.2,0.7), B(2.2,0.7), C(1.0,-1.1), D(4.0,-1.1) -->
    <model name="line_network">
      <static>true</static>
      <link name="line_link">

        <!-- S -> A -->
        <visual name="seg_sa">
          <pose>1.7 1.45 0.001 0 0 -2.678</pose>
          <geometry><box><size>3.36 0.22 0.001</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>

        <!-- A -> B -->
        <visual name="seg_ab">
          <pose>1.2 0.7 0.001 0 0 0</pose>
          <geometry><box><size>2.0 0.22 0.001</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>

        <!-- A -> C -->
        <visual name="seg_ac">
          <pose>0.6 -0.2 0.001 0 0 -1.107</pose>
          <geometry><box><size>2.0 0.22 0.001</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>

        <!-- C -> B -->
        <visual name="seg_cb">
          <pose>1.6 -0.2 0.001 0 0 1.012</pose>
          <geometry><box><size>2.25 0.22 0.001</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>

        <!-- B -> D -->
        <visual name="seg_bd">
          <pose>3.1 -0.2 0.001 0 0 -1.012</pose>
          <geometry><box><size>2.25 0.22 0.001</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>

        <!-- C -> D -->
        <visual name="seg_cd">
          <pose>2.5 -1.1 0.001 0 0 0</pose>
          <geometry><box><size>3.0 0.22 0.001</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>

      </link>
    </model>

    <!-- Obstacles on multiple branches -->
    <model name="obstacle_sa">
      <static>true</static>
      <pose>1.9 1.55 0.16 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.28 0.28 0.32</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.28 0.28 0.32</size></box></geometry><material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material></visual>
      </link>
    </model>

    <model name="obstacle_ab">
      <static>true</static>
      <pose>1.35 0.7 0.16 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.28 0.28 0.32</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.28 0.28 0.32</size></box></geometry><material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material></visual>
      </link>
    </model>

    <model name="obstacle_cb">
      <static>true</static>
      <pose>1.5 -0.35 0.16 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.26 0.26 0.32</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.26 0.26 0.32</size></box></geometry><material><ambient>1 0.3 0.1 1</ambient><diffuse>1 0.3 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <model name="obstacle_cd">
      <static>true</static>
      <pose>2.7 -1.1 0.16 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.26 0.26 0.32</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.26 0.26 0.32</size></box></geometry><material><ambient>1 0.2 0.2 1</ambient><diffuse>1 0.2 0.2 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
